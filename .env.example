# Event Management System - Environment Configuration
# Copy this file to .env and update values for your environment

# Flask Environment
FLASK_ENV=development

# Secret Key (Generate a secure random string for production)
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# Database Configuration
# Development: SQLite (default in config.py)
# Production: MySQL
DATABASE_URL=mysql+pymysql://root:password@localhost/ems_production

# Database Credentials for MySQL
DB_USER=root
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ems_production

# Upload Settings
MAX_UPLOAD_SIZE_MB=16
UPLOAD_FOLDER=app/static/uploads
QRCODE_FOLDER=app/static/qrcodes

# Email Configuration (for future use)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Admin Configuration (Change these in production!)
# Generate secure password: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_in_production
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_password

# Security Settings
SESSION_TIMEOUT_MINUTES=60

# Debug Mode (Never True in production)
DEBUG=False

# Log Level
LOG_LEVEL=INFO

# SMS Notifications (optional - Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Cloud Storage (optional - S3-compatible)
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_REGION=ap-south-1
CLOUD_STORAGE_PUBLIC_BASE_URL=
